# 环境变量示例：复制为 .env 后按本机情况填写
# .env 已被 .gitignore 忽略，切勿提交任何真实凭据
# 说明：Spring Boot 直接读取进程环境变量，.env 仅供记录/配合本地启动脚本使用。

# ── 数据库 ──────────────────────────────────────────────
# 下列为本机演示库默认值，部署到任何非本机环境前务必修改
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mall
DB_USER=root
DB_PASSWORD=123456

# ── JWT 签名密钥 ────────────────────────────────────────
# 生产环境必须替换为 >=32 字节的随机串，禁止使用仓库内的开发占位值
# 生成示例：openssl rand -hex 32
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes

# ── 前端（可选）──────────────────────────────────────────
# 后端不在 8080 时，四个前端用 VITE_API_TARGET 覆盖代理目标
# VITE_API_TARGET=http://localhost:8081
